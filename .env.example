# Copy this file to .env and fill in the credentials you have.
# Any platform with missing credentials is skipped with a warning — you can go live one platform at a time.

# ── Content generation (required) ───────────────────────────────
# https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# ── X (Twitter) — developer.x.com, free tier works ──────────────
# Create a project+app, enable OAuth 1.0a with Read/Write, generate all four:
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── Facebook Page + Instagram — developers.facebook.com ─────────
# Create an app → add "Facebook Login" + "Instagram Graph API" products.
# Get a long-lived PAGE access token with pages_manage_posts, pages_read_engagement,
# instagram_basic, instagram_content_publish. Easiest via Graph API Explorer.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Instagram BUSINESS account ID linked to that page (Graph API: /{page-id}?fields=instagram_business_account)
IG_USER_ID=

# ── Instagram needs media at a public URL — Cloudinary free tier hosts it ──
# https://cloudinary.com → Dashboard → API keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── LinkedIn — developer.linkedin.com ────────────────────────────
# Create an app → request "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect".
# Generate a 60-day access token (OAuth tools tab) with w_member_social, openid, profile.
LINKEDIN_ACCESS_TOKEN=

# ── Optional: automatic TikTok + YouTube via upload-post.com ─────
# If set AND config video_delivery = "upload_post", shorts publish automatically.
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
